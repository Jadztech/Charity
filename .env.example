# Copy to .env.local (Next.js) and NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ may reach the browser.

# --- Supabase (used from Stage 2 onward) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # safe for the browser; RLS protects data
SUPABASE_SERVICE_ROLE_KEY=                # SERVER / EDGE FUNCTION ONLY. Bypasses RLS.

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (Stage 3+; use TEST/SANDBOX keys until launch) --------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=                        # server only
STRIPE_WEBHOOK_SECRET=                    # server only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=                     # server only
PAYPAL_WEBHOOK_ID=
# Coinbase Commerce: dashboard.commerce.coinbase.com -> Settings -> API keys / Notifications
COINBASE_COMMERCE_API_KEY=                # server only
COINBASE_COMMERCE_WEBHOOK_SECRET=         # server only (shared secret shown next to the webhook endpoint)

# Binance Pay merchant account required. Not available to every donor or every merchant --
# restricted/unavailable in a number of countries, including the United States. Confirm
# eligibility and compliance requirements for a charity before enabling this in production.
BINANCE_PAY_API_KEY=                      # server only (this is the "Certificate SN" / API key)
BINANCE_PAY_SECRET_KEY=                   # server only
# PEM public key fetched once via Binance Pay's Query Certificate API; verifies incoming
# webhooks. Store the full "-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----" block.
BINANCE_PAY_WEBHOOK_PUBLIC_KEY=           # server only

# NOTE: the crypto charge/webhook route handlers also require SUPABASE_SERVICE_ROLE_KEY
# (declared above) to bypass RLS via lib/supabase/service.ts. NEVER expose that key to the browser.

# --- Email (Stage 4; provider still to be chosen) ------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Image providers (Stage 6) -------------------------------------------
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
